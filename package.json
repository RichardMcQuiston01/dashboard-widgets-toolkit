{
  "name": "@richardmcquiston01/dashboard-widgets-toolkit",
  "version": "0.33.0",
  "description": "Framework-agnostic dashboard widget toolkit: typed widget definitions and data payloads (KPI, gauge, table, bar list, alert list, chart), user layout (order, hide, minimise), and React renderers. Bring your own data providers.",
  "keywords": [
    "dashboard",
    "widgets",
    "kpi",
    "gauge",
    "chart",
    "svg",
    "layout",
    "react",
    "vue",
    "typescript",
    "accessibility"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston (https://richardmcquiston.com/)",
  "funding": {
    "type": "individual",
    "url": "https://donate.stripe.com/00w5kD3Gj1Xo9v7gVOcs800"
  },
  "homepage": "https://github.com/RichardMcQuiston01/dashboard-widgets-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/dashboard-widgets-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/dashboard-widgets-toolkit/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "builder": [
        "./dist/builder.d.cts"
      ],
      "core": [
        "./dist/core.d.cts"
      ],
      "react": [
        "./dist/react.d.cts"
      ],
      "vue": [
        "./dist/vue.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./builder": {
      "import": {
        "types": "./dist/builder.d.ts",
        "default": "./dist/builder.js"
      },
      "require": {
        "types": "./dist/builder.d.cts",
        "default": "./dist/builder.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.vue.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@richardmcquiston01/storage-adapters": "^0.3.0"
  }
}
